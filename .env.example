# Upstash Redis REST API Config (Production)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Upstash Redis REST API Config (Staging/Test - Dùng riêng cho seed/benchmark/test môi trường cách ly)
UPSTASH_REDIS_REST_URL_STAGING=https://your-staging-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN_STAGING=your_staging_upstash_token_here

# JWT Secret Key for Authentication
JWT_SECRET=super_secret_jwt_key_mes_lite_2026

# Admin Seed Password for System Initialization / Reset
SEED_ADMIN_PASSWORD=<dat_mat_khau_manh_rieng_khong_commit_giatri_that>

# Supabase API Config (Production PostgreSQL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct Database Connection String
